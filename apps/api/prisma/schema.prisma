// Prisma schema for Web3 Freelance Platform Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  FREELANCER
  JUROR
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  FREELANCER_SELECTED
  OPEN
  IN_PROGRESS
  COMPLETED
  DISPUTED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  VERIFYING
  APPROVED
  RELEASED
  DISPUTED
  PROCESSING_AUTORELEASE
  LOCKED
  IN_PROGRESS
  PENDING_APPROVAL
  REVISION_REQUESTED
  COMPLETED
}

enum DisputeStatus {
  OPEN
  VOTING
  RESOLVED
}

enum NotificationType {
  JOB_POSTED
  APPLICATION_RECEIVED
  APPLICATION_ACCEPTED
}

enum VoteChoice {
  FREELANCER_FAVOR
  CLIENT_FAVOR
}

// Ledger enums mirror the already-live "LedgerEntry" table (migration
// 20260904000001_add_ledger, applied to the DB before this schema entry was
// added). JOB_CREATED / JOB_ACTIVATED are new, additive enum values needed
// to log real job-level lifecycle events — see migration
// 20260905000000_ledger_job_events for the minimal `ALTER TYPE ... ADD VALUE`.
enum LedgerEventType {
  JOB_CREATED
  JOB_ACTIVATED
  ESCROW_CREATED
  ESCROW_FUNDED
  ESCROW_STATUS_CHANGED
  ESCROW_CANCELLED
  ESCROW_COMPLETED
  MILESTONE_CREATED
  MILESTONE_SUBMITTED
  MILESTONE_APPROVED
  MILESTONE_REJECTED
  MILESTONE_RELEASED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  PAYMENT_REFUNDED
  BLOCKCHAIN_PENDING
  BLOCKCHAIN_CONFIRMED
  BLOCKCHAIN_FAILED
}

enum LedgerStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  CANCELLED
}

model User {
  id                String           @id @default(uuid())
  email             String?          @unique
  passwordHash      String?
  walletAddress     String?          @unique
  siweNonce         String?
  role              Role             @default(FREELANCER)
  name              String?
  bio               String?
  location          String?
  rating            Float            @default(5.0)
  portfolioLinks    String[]         @default([])
  skills            String[]         @default([])
  isPro             Boolean          @default(false)
  jobsPostedCount   Int              @default(0)
  jobsAppliedCount  Int              @default(0)

  // Post-signup profile-setup gate.
  onboardingCompleted Boolean        @default(false)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  postedJobs        Job[]            @relation("ClientJobs")
  assignedJobs      Job[]            @relation("FreelancerJobs")
  applications      JobApplication[] @relation("FreelancerApplications")
  initiatedDisputes Dispute[]        @relation("InitiatedDisputes")

  conversations           ConversationParticipant[] @relation("UserConversations")
  sentMessages            Message[]                 @relation("SentMessages")
  freelancerConversations Conversation[]            @relation("FreelancerConversations")
  notifications           Notification[]            @relation("UserNotifications")
}

model Job {
  id             String           @id @default(uuid())
  title          String
  description    String
  budget         Float
  tokenSymbol    String           @default("ETH")
  skills         String[]         @default([])
  deadline       DateTime?
  escrowAddress  String?
  status         JobStatus        @default(DRAFT)

  clientId       String
  client         User             @relation("ClientJobs", fields: [clientId], references: [id])

  freelancerId   String?
  freelancer     User?            @relation("FreelancerJobs", fields: [freelancerId], references: [id])

  milestones     Milestone[]
  applications   JobApplication[]
  disputes       Dispute[]
  conversations  Conversation[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Milestone {
  id                   String          @id @default(uuid())
  jobId                String
  job                  Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  order                Int             @default(1)
  title                String
  description          String
  amount               Float
  deadline             DateTime?
  deliverableLink      String?
  deliverableNotes     String?
  githubPrUrl          String?
  deploymentUrl        String?
  aiReviewScore        Float?
  status               MilestoneStatus @default(LOCKED)
  submittedAt          DateTime?
  verificationDeadline DateTime?
  revisionReason       String?

  disputes             Dispute[]

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model JobApplication {
  id            String            @id @default(uuid())
  jobId         String
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId  String
  freelancer    User              @relation("FreelancerApplications", fields: [freelancerId], references: [id])

  pitch         String
  requestedRate Float
  deliveryDays  Int?              @default(7)
  walletAddress String?
  status        ApplicationStatus @default(SUBMITTED)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([jobId, freelancerId])
}

model Dispute {
  id           String        @id @default(uuid())
  jobId        String
  job          Job           @relation(fields: [jobId], references: [id])
  milestoneId  String
  milestone    Milestone     @relation(fields: [milestoneId], references: [id])
  initiatorId  String
  initiator    User          @relation("InitiatedDisputes", fields: [initiatorId], references: [id])

  reason       String
  evidenceUrls String[]      @default([])
  status       DisputeStatus @default(OPEN)

  votes        JurorVote[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model JurorVote {
  id            String     @id @default(uuid())
  disputeId     String
  dispute       Dispute    @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  jurorAddress  String
  vote          VoteChoice
  rewardClaimed Boolean    @default(false)
  createdAt     DateTime   @default(now())
}

model Admin {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique
  password   String
  name       String
  seatNumber Int?      @default(1) @map("seat_number")
  title      String?   @default("Platform Arbitrator")
  role       String?   @default("ADMIN")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admins")
}

// ---------------------------------------------------------------------------
// Messaging
// A Conversation is a job-scoped thread between the Job's client and ONE
// freelancer (the `freelancerId` side; the client is the other participant).
// `@@unique([jobId, freelancerId])` means a given (job, freelancer) pair always
// resolves to the same conversation — no duplicates — while still allowing every
// applicant on a job to have their own thread with the client. Both columns are
// optional to leave room for future direct (job-less) threads.
// ---------------------------------------------------------------------------

model Conversation {
  id           String                    @id @default(uuid())
  jobId        String?
  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancerId String?
  freelancer   User?                     @relation("FreelancerConversations", fields: [freelancerId], references: [id], onDelete: Cascade)

  participants ConversationParticipant[]
  messages     Message[]

  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  jobId     String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  content        String

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  editedAt       DateTime?
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// Append-only financial/event ledger. No relations/FKs by design (matches the
// already-live table exactly) — entries reference jobs/milestones/escrows by
// plain id so a ledger-recording failure can never cascade into or block the
// real business write it is observing. There is no dedicated jobId column on
// the live table; jobId is carried in `details` (jsonb) on every entry.
model LedgerEntry {
  id                        String          @id @default(uuid())
  escrowId                  String?
  milestoneId               String?
  transactionId             String?
  eventType                 LedgerEventType
  status                    LedgerStatus
  actorId                   String?
  actorRole                 String?
  amount                    Float?
  currency                  String?
  previousStatus            String?
  newStatus                 String?
  description               String
  details                   Json?
  blockchainTransactionHash String?
  dedupeKey                 String?         @unique
  createdAt                 DateTime        @default(now())

  @@index([milestoneId])
  @@index([escrowId, createdAt])
  @@index([transactionId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}
